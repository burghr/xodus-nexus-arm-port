#!/bin/sh
# Start the native arm64 Xodus Nexus AppImage on ArmadaOS.
# https://github.com/burghr/xodus-nexus-arm-port
#
# The name and the paths come from the earlier x86_64 install. Keep them, so
# that the Steam shortcuts of existing installs still work.

LIB_DIR="$HOME/.local/lib/xodus-x86_64"
APPIMAGE_FILE="${XODUS_NEXUS_APPIMAGE:-$HOME/.local/share/xodus-nexus-fex/Xodus-Nexus.AppImage}"

if [ ! -f "$APPIMAGE_FILE" ]; then
  echo "Xodus Nexus AppImage not found: $APPIMAGE_FILE" >&2
  echo "Run install.sh again, or set XODUS_NEXUS_APPIMAGE." >&2
  exit 1
fi

# Use the pkexec stand-in. At sign-in, the backend uses pkexec to read SMBIOS
# data. ARM devices have no SMBIOS data, so the real pkexec prompt for it
# fails again and again. Xodus Nexus opens the KDE wallet itself.
export PATH="$LIB_DIR/bin:$PATH"
exec "$APPIMAGE_FILE" "$@"
